# Copy this file to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod
# Never commit .env.prod — it is gitignored.
#
# Production image tag (CI overwrites /opt/careerpulse/.env.deploy):
# CAREERPULSE_IMAGE=ghcr.io/<github-org-or-user>/<repo>:sha-<git-sha>

# ── PUBLIC BUILD-TIME (also set as GitHub Actions variables for image builds) ─
# Must be the public HTTPS origin in production (not localhost, not Docker DNS).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Leave empty in Docker/production. Only used by `npm run dev`.
NEXT_PUBLIC_DEV_SUBSCRIPTION_PLAN=

# ── SERVER-ONLY NON-SECRET ───────────────────────────────────────────────────
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
POSTGRES_USER=careerpulse
POSTGRES_DB=careerpulse
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CV_ANALYZER_API_MODEL=claude-haiku-4-5-20251001
EMAIL_FROM=noreply@yourdomain.com
SSLCOMMERZ_IS_LIVE=false
# APP_BIND_HOST=127.0.0.1
# APP_PORT=3000

# ── PRIVATE RUNTIME SECRET ───────────────────────────────────────────────────
POSTGRES_PASSWORD=replace-with-a-strong-password
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
JWT_SECRET=replace-me-with-openssl-rand-base64-32
ANTHROPIC_API_KEY=
SUPER_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
