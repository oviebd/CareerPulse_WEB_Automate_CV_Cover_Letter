# Copy this file to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod
# Never commit .env.prod — it is gitignored.

# ── App (baked into the client bundle at Docker build time) ──────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave empty in Docker/production. Only used by `npm run dev`.
NEXT_PUBLIC_DEV_SUBSCRIPTION_PLAN=

# ── Postgres (used by docker compose) ────────────────────────────────────────
POSTGRES_USER=careerpulse
POSTGRES_PASSWORD=careerpulse_dev
POSTGRES_DB=careerpulse

# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string

# ── AI (required for CV / cover-letter generation) ───────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CV_ANALYZER_API_MODEL=claude-haiku-4-5-20251001

# ── Super Admin (comma-separated emails promoted on register/login) ───────────
SUPER_ADMIN_EMAILS=admin@yourdomain.com

# ── File storage ─────────────────────────────────────────────────────────────
# Docker compose sets UPLOAD_DIR=/data/uploads. For `npm run dev` on the host,
# put UPLOAD_DIR=./data/uploads in `.env.local` instead.
# UPLOAD_DIR=/data/uploads

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (optional) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ── Payments (optional) ──────────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
