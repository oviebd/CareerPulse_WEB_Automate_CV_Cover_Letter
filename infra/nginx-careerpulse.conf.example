# Host Nginx example for CareerPulse on a shared VPS.
# Install as /etc/nginx/sites-available/careerpulse and enable the site.
# Replace careerpulse.example.com with the real public hostname.
# TLS is issued on the VPS (certbot). Do not commit certificates.

server {
    listen 80;
    listen [::]:80;
    server_name careerpulse.example.com;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

# After `certbot --nginx`, HTTP should redirect to HTTPS.
# HSTS is typically added by certbot; keep a long max-age only after HTTPS is verified:
# add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
