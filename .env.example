# Copy to .env.prod (Docker) or .env.local (hybrid `npm run dev`).
# Never commit real secrets.

# ── Classification ───────────────────────────────────────────────────────────
# PUBLIC BUILD-TIME (baked into the browser bundle; not secrets)
# PUBLIC RUNTIME (safe to expose to the browser)
# PRIVATE RUNTIME SECRET (server only)
# SERVER-ONLY NON-SECRET CONFIGURATION

# ── PUBLIC BUILD-TIME ────────────────────────────────────────────────────────
# Production must be the public HTTPS origin, never localhost or a Docker hostname.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Same value as GOOGLE_CLIENT_ID. Optional. Required to show Google sign-in in the UI.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Leave empty in Docker/production. Only used by `npm run dev`.
NEXT_PUBLIC_DEV_SUBSCRIPTION_PLAN=
# Paddle.js (sandbox | live). Baked into the client bundle.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_deacffa91ad71d0fae544e72aa9
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=pri_01m2hn22a4w4denk5mwxqfadfw
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=pri_01m2hr0rctb0accb7c5xtds9tv
NEXT_PUBLIC_PADDLE_PRICE_PACK_CREDITS5=
NEXT_PUBLIC_PADDLE_PRICE_PACK_CREDITS10=
# When false, AI usage nav/API is super_admin only (default: visible).
NEXT_PUBLIC_SHOW_AI_USAGE=true

# ── SERVER-ONLY NON-SECRET CONFIGURATION ─────────────────────────────────────
# Auth.js canonical URL. Set to the same HTTPS origin as NEXT_PUBLIC_APP_URL in production.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
POSTGRES_USER=careerpulse
POSTGRES_DB=careerpulse
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CV_ANALYZER_API_MODEL=claude-haiku-4-5-20251001
EMAIL_FROM=noreply@yourdomain.com
PADDLE_API_VERSION=1
# Docker compose sets UPLOAD_DIR=/data/uploads. Hybrid npm run dev:
# UPLOAD_DIR=./data/uploads
# Host bind for production compose (shared VPS). Defaults are 127.0.0.1:3000.
# APP_BIND_HOST=127.0.0.1
# APP_PORT=3000
# Immutable image tag written by CI on the VPS (do not put secrets here).
# CAREERPULSE_IMAGE=ghcr.io/<github-org-or-user>/<repo>:sha-<commit>
# Optional Next.js remote image hosts (comma-separated hostnames).
# NEXT_IMAGE_ALLOWED_HOSTS=

# ── PRIVATE RUNTIME SECRET ───────────────────────────────────────────────────
POSTGRES_PASSWORD=replace-with-a-strong-password
# Compose sets DATABASE_URL for the app container. For hybrid npm run dev:
# DATABASE_URL=postgresql://careerpulse:replace-with-a-strong-password@localhost:5432/careerpulse
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
JWT_SECRET=replace-me-with-openssl-rand-base64-32
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Bearer token for GET /api/cron/yearly-pro-credits (yearly Pro monthly safety credits).
CRON_SECRET=
# Comma-separated emails promoted to super_admin on register/login.
SUPER_ADMIN_EMAILS=
